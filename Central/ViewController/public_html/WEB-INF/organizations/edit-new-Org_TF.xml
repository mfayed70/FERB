<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="edit-new-Org_TF">
    <default-activity>router1</default-activity>
    <transaction>
      <requires-transaction/>
    </transaction>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__8">
      <name>pOrgCode</name>
      <value>#{pageFlowScope.pOrgCode}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <input-parameter-definition id="__9">
      <name>pAction</name>
      <value>#{pageFlowScope.pAction}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <router id="router1">
      <case id="__10">
        <expression>#{pageFlowScope.pAction=='new'}</expression>
        <outcome>new</outcome>
      </case>
      <default-outcome>edit</default-outcome>
    </router>
    <method-call id="ExecuteWithParams">
      <method>#{bindings.ExecuteWithParams.execute}</method>
      <outcome>
        <fixed-outcome>ExecuteWithParams</fixed-outcome>
      </outcome>
    </method-call>
    <method-call id="CreateWithParameters">
      <method>#{bindings.CreateWithParams.execute}</method>
      <outcome>
        <fixed-outcome>CreateWithParams</fixed-outcome>
      </outcome>
    </method-call>
    <view id="OrgCrud">
      <page>/WEB-INF/organizations/OrgCrud.jsf</page>
    </view>
    <task-flow-return id="Save">
      <outcome>
        <name>Save</name>
        <commit/>
      </outcome>
    </task-flow-return>
    <task-flow-return id="Cancel">
      <outcome>
        <name>Cancel</name>
        <rollback/>
      </outcome>
    </task-flow-return>
    <control-flow-rule id="__1">
      <from-activity-id>router1</from-activity-id>
      <control-flow-case id="__2">
        <from-outcome>edit</from-outcome>
        <to-activity-id>ExecuteWithParams</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__3">
        <from-outcome>new</from-outcome>
        <to-activity-id>CreateWithParameters</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__4">
      <from-activity-id>ExecuteWithParams</from-activity-id>
      <control-flow-case id="__5">
        <from-outcome>ExecuteWithParams</from-outcome>
        <to-activity-id>OrgCrud</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__6">
      <from-activity-id>CreateWithParameters</from-activity-id>
      <control-flow-case id="__7">
        <from-outcome>CreateWithParams</from-outcome>
        <to-activity-id>OrgCrud</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__11">
      <from-activity-id>OrgCrud</from-activity-id>
      <control-flow-case id="__12">
        <from-outcome>toSave</from-outcome>
        <to-activity-id>Save</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__13">
        <from-outcome>toCancel</from-outcome>
        <to-activity-id>Cancel</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
  </task-flow-definition>
</adfc-config>
