<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE html>
<f:view xmlns:f="http://java.sun.com/jsf/core" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
        xmlns:c="http://java.sun.com/jsp/jstl/core">
    <c:set var="viewcontrollerBundle" value="#{adfBundle['com.aalm.center.view.AalmCenteralBndl']}"/>
    <af:document id="d1">
        <af:messages id="m1"/>
        <af:form id="f1">
            <af:panelHeader text="#{viewcontrollerBundle.EditNewOrganization}" id="ph1">
                <f:facet name="context"/>
                <f:facet name="menuBar">
                    <af:button text="#{viewcontrollerBundle.SAVE}" id="b2" icon="#{resource['images:SaveF.png']}"
                               hoverIcon="#{resource['images:SaveO.png']}" action="toSave"/>
                </f:facet>
                <f:facet name="toolbar">
                    <af:button text="#{viewcontrollerBundle.CANCEL}" id="b1" icon="#{resource['images:cancelF.png']}"
                               hoverIcon="#{resource['images:cancelO.png']}" action="toCancel"/>
                </f:facet>
                <f:facet name="legend">
                    <af:spacer width="10" height="20" id="s1"/>
                </f:facet>
                <af:panelFormLayout id="pfl1">
                    <af:inputText value="#{bindings.OrgCode.inputValue}" label="#{bindings.OrgCode.hints.label}"
                                  required="#{bindings.OrgCode.hints.mandatory}"
                                  columns="#{bindings.OrgCode.hints.displayWidth}"
                                  maximumLength="#{bindings.OrgCode.hints.precision}"
                                  shortDesc="#{bindings.OrgCode.hints.tooltip}" id="it1">
                        <f:validator binding="#{bindings.OrgCode.validator}"/>
                        <af:convertNumber groupingUsed="false" pattern="#{bindings.OrgCode.format}"/>
                    </af:inputText>
                    <af:inputText value="#{bindings.EnOrgName.inputValue}" label="#{bindings.EnOrgName.hints.label}"
                                  required="#{bindings.EnOrgName.hints.mandatory}"
                                  columns="#{bindings.EnOrgName.hints.displayWidth}"
                                  maximumLength="#{bindings.EnOrgName.hints.precision}"
                                  shortDesc="#{bindings.EnOrgName.hints.tooltip}" id="it2">
                        <f:validator binding="#{bindings.EnOrgName.validator}"/>
                    </af:inputText>
                    <af:inputText value="#{bindings.ArOrgName.inputValue}" label="#{bindings.ArOrgName.hints.label}"
                                  required="#{bindings.ArOrgName.hints.mandatory}"
                                  columns="#{bindings.ArOrgName.hints.displayWidth}"
                                  maximumLength="#{bindings.ArOrgName.hints.precision}"
                                  shortDesc="#{bindings.ArOrgName.hints.tooltip}" id="it3">
                        <f:validator binding="#{bindings.ArOrgName.validator}"/>
                    </af:inputText>
                    <af:selectOneChoice value="#{bindings.PrntOrgCode.inputValue}" label="#{bindings.PrntOrgCode.label}"
                                        required="#{bindings.PrntOrgCode.hints.mandatory}"
                                        shortDesc="#{bindings.PrntOrgCode.hints.tooltip}" id="soc1">
                        <f:selectItems value="#{bindings.PrntOrgCode.items}" id="si1"/>
                        <f:validator binding="#{bindings.PrntOrgCode.validator}"/>
                    </af:selectOneChoice>
                    <af:selectOneChoice value="#{bindings.OrgType.inputValue}" label="#{bindings.OrgType.label}"
                                        required="#{bindings.OrgType.hints.mandatory}"
                                        shortDesc="#{bindings.OrgType.hints.tooltip}" id="soc2">
                        <f:selectItems value="#{bindings.OrgType.items}" id="si2"/>
                        <f:validator binding="#{bindings.OrgType.validator}"/>
                    </af:selectOneChoice>
                </af:panelFormLayout>
                <f:facet name="info"/>
            </af:panelHeader>
        </af:form>
    </af:document>
</f:view>