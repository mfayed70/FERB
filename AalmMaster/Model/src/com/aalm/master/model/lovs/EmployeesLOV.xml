<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="EmployeesLOV"
  Version="12.1.3.10.47"
  InheritPersonalization="merge"
  BindingStyle="JDBC"
  CustomQuery="true"
  PageIterMode="Full">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.aalm.master.model.lovs.EmployeesLOV_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <SQLQuery><![CDATA[SELECT e.emp_id, ec.first_name, ec.last_name, ec.contract_apply_dt
,e.org_code, e.emp_name
FROM EMPLOYEES e
JOIN EMPLOYEES_CONTRACTS ec
    ON e.emp_id = ec.emp_id
WHERE ec.contract_apply_dt = (
    SELECT MAX(ec2.contract_apply_dt)
    FROM EMPLOYEES_CONTRACTS ec2
    WHERE ec2.emp_id = e.emp_id
)]]></SQLQuery>
  <ViewAttribute
    Name="EmpId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.lang.Integer"
    ColumnType="INTEGER"
    AliasName="emp_id"
    Expression="emp_id"
    SQLType="INTEGER">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="11"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="FirstName"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="100"
    Type="java.lang.String"
    ColumnType="VARCHAR"
    AliasName="first_name"
    Expression="first_name"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="100"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="LastName"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="100"
    Type="java.lang.String"
    ColumnType="VARCHAR"
    AliasName="last_name"
    Expression="last_name"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="100"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="ContractApplyDt"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.sql.Timestamp"
    ColumnType="DATETIME"
    AliasName="contract_apply_dt"
    Expression="contract_apply_dt"
    SQLType="TIMESTAMP"/>
  <ViewAttribute
    Name="OrgCode"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.lang.Integer"
    ColumnType="INT"
    AliasName="org_code"
    Expression="org_code"
    SQLType="INTEGER">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="11"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="EmpName"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="100"
    Type="java.lang.String"
    ColumnType="VARCHAR"
    AliasName="emp_name"
    Expression="emp_name"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="100"/>
    </DesignTime>
