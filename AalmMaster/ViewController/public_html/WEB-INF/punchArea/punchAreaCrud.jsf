              }
            </af:resource>-->
<af:resource type="javascript">
//<![CDATA[

    var mapRendered = false;
    var retryInterval = null;

    window.addEventListener("load", function () {

        startRetryLoop();

        var formEl = document.getElementById("f1");
        if (formEl && window.MutationObserver) {
            var observer = new MutationObserver(function () {
                renderMapIfReady();
            });
            observer.observe(formEl, { childList: true, subtree: true });
        }
    });

    function startRetryLoop() {
        var attempts = 0;
        var maxAttempts = 17;

        retryInterval = window.setInterval(function () {
            attempts++;

            var success = renderMapIfReady();

            if (success || attempts >= maxAttempts) {
                window.clearInterval(retryInterval);
                retryInterval = null;
            }
        }, 300);
    }

    function renderMapIfReady() {

        var latInput    = document.querySelector('input[id$="it7::content"]');
        var lonInput    = document.querySelector('input[id$="it6::content"]');
        var radiusInput = document.querySelector('input[id$="it3::content"]');

        if (!latInput || !lonInput || !radiusInput)
            return false;

        var lat    = parseFloat(latInput.value);
        var lon    = parseFloat(lonInput.value);
        var radius = parseFloat(radiusInput.value);

        if (isNaN(lat) || isNaN(lon) || lat === 0 || lon === 0)
            return false;

        if (isNaN(radius) || radius === 0 || radius !== Math.abs(radius))
            radius = 200;

        updateMap(lat.toFixed(6), lon.toFixed(6), radius);
        return true;
    }

    function onCollectLocation(evt) {
        evt.cancel();

        if (!navigator.geolocation) {
            alert("Geolocation not supported.");
            return;
        }

        navigator.geolocation.getCurrentPosition(
            function (pos) {
                var lat = pos.coords.latitude.toFixed(6);
                var lon = pos.coords.longitude.toFixed(6);

                var latInput    = document.querySelector('input[id$="it7::content"]');
                var lonInput    = document.querySelector('input[id$="it6::content"]');
                var radiusInput = document.querySelector('input[id$="it3::content"]');

                if (latInput) latInput.value = lat;
                if (lonInput) lonInput.value = lon;

                notifyAdf(latInput);
                notifyAdf(lonInput);

                var radius = radiusInput ? parseFloat(radiusInput.value) : 200;
                if (isNaN(radius) || radius === 0 || radius !== Math.abs(radius))
                    radius = 200;

                updateMap(lat, lon, radius);
            },
            function (error) {
                alert("Location error: " + error.message);
            },
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
        );
    }

    function getZoomForRadius(radiusMetres, lat) {

        if (!radiusMetres || radiusMetres === 0 || radiusMetres !== Math.abs(radiusMetres))
            return 15;

        var earthCircumference = 40075016;
        var tileSize           = 256;
        var mapWidthPx         = Math.min(window.innerWidth, 500);
        var latRad             = parseFloat(lat) * Math.PI / 180;
        var mpp                = (radiusMetres * 2) / mapWidthPx;
        var zoom               = Math.log(
                                     (earthCircumference * Math.cos(latRad)) /
                                     (tileSize * mpp)
                                 ) / Math.log(2);

        zoom = Math.floor(zoom);

        // Clamp between 1 and 20 without using < or >
        zoom = Math.max(1, Math.min(20, zoom));

        return zoom;
    }

    function updateMap(lat, lon, radius) {

        var mapFrame = document.querySelector('iframe[id$="mapFrame"]');
        if (!mapFrame)
            return;

        var zoom   = getZoomForRadius(radius, lat);
        var newSrc = "https://maps.google.com/maps?q=" + lat + "," + lon
                   + "&z=" + zoom + "&output=embed";

        if (mapFrame.getAttribute("src") !== newSrc) {
            mapFrame.setAttribute("src", newSrc);
            mapRendered = true;
        }
    }

    function notifyAdf(input) {
        if (!input)
            return;
        var ev = document.createEvent("HTMLEvents");
        ev.initEvent("change", true, true);
        input.dispatchEvent(ev);
    }

//]]>
</af:resource>
        </af:form>
    </af:document>
</f:view>