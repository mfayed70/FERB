<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="punch_area-TF">
    <default-activity>Execute</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <method-call id="Execute">
      <method>#{bindings.Execute.execute}</method>
      <outcome>
        <fixed-outcome>Execute</fixed-outcome>
      </outcome>
    </method-call>
    <view id="punchArea">
      <page>/WEB-INF/punchArea/punchArea.jsff</page>
    </view>
    <task-flow-call id="punch_area_CRUD-TF">
      <task-flow-reference>
        <document>/WEB-INF/punchArea/punch_area_CRUD-TF.xml</document>
        <id>punch_area_CRUD-TF</id>
      </task-flow-reference>
      <input-parameter id="__3">
        <name>pId</name>
        <value>#{pageFlowScope.pId}</value>
      </input-parameter>
      <run-as-dialog>
        <display-type>
          <inline-popup/>
        </display-type>
      </run-as-dialog>
    </task-flow-call>
    <control-flow-rule id="__1">
      <from-activity-id>Execute</from-activity-id>
      <control-flow-case id="__2">
        <from-outcome>Execute</from-outcome>
        <to-activity-id>punchArea</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__4">
      <from-activity-id>punchArea</from-activity-id>
      <control-flow-case id="__5">
        <from-outcome>toCrud</from-outcome>
        <to-activity-id>punch_area_CRUD-TF</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
