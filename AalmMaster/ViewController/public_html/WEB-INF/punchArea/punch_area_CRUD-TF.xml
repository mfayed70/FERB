<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="punch_area_CRUD-TF">
    <default-activity>router1</default-activity>
    <transaction>
      <requires-transaction/>
    </transaction>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__8">
      <name>pId</name>
      <value>#{pageFlowScope.pId}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <managed-bean id="__15">
      <managed-bean-name>PunchAreaBean</managed-bean-name>
      <managed-bean-class>com.aalm.master.view.beans.PunchAreaBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <router id="router1">
      <case id="__10">
        <expression>#{pageFlowScope.pId!=null}</expression>
        <outcome>edit</outcome>
      </case>
      <default-outcome>new</default-outcome>
    </router>
    <method-call id="CreateInsert">
      <method>#{bindings.CreateInsert.execute}</method>
      <outcome>
        <fixed-outcome>CreateInsert</fixed-outcome>
      </outcome>
    </method-call>
    <method-call id="ExecuteWithParams">
      <method>#{bindings.ExecuteWithParams.execute}</method>
      <outcome>
        <fixed-outcome>ExecuteWithParams</fixed-outcome>
      </outcome>
    </method-call>
    <view id="punchAreaCrud">
      <page>/WEB-INF/punchArea/punchAreaCrud.jsf</page>
    </view>
    <task-flow-return id="Commit">
      <outcome>
        <name>Commit</name>
        <commit/>
      </outcome>
    </task-flow-return>
    <task-flow-return id="Rollback">
      <outcome>
        <name>Rollback</name>
        <rollback/>
      </outcome>
    </task-flow-return>
    <control-flow-rule id="__1">
      <from-activity-id>router1</from-activity-id>
      <control-flow-case id="__2">
        <from-outcome>new</from-outcome>
        <to-activity-id>CreateInsert</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__3">
        <from-outcome>edit</from-outcome>
        <to-activity-id>ExecuteWithParams</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__4">
      <from-activity-id>CreateInsert</from-activity-id>
      <control-flow-case id="__5">
        <from-outcome>CreateInsert</from-outcome>
        <to-activity-id>punchAreaCrud</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__6">
      <from-activity-id>ExecuteWithParams</from-activity-id>
      <control-flow-case id="__7">
        <from-outcome>ExecuteWithParams</from-outcome>
        <to-activity-id>punchAreaCrud</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__11">
      <from-activity-id>punchAreaCrud</from-activity-id>
      <control-flow-case id="__12">
        <from-outcome>toSave</from-outcome>
        <to-activity-id>Commit</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__13">
        <from-outcome>toCancel</from-outcome>
        <to-activity-id>Rollback</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
  </task-flow-definition>
</adfc-config>
