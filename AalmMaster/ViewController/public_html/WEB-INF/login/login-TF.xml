<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="login-TF">
    <template-reference>
      <document>/WEB-INF/page-gragment-template.xml</document>
      <id>page-gragment-template</id>
    </template-reference>
    <default-activity>login</default-activity>
    <input-parameter-definition id="__10">
      <name>successfulLogin</name>
      <value>#{pageFlowScope.successfulLogin}</value>
      <class>java.lang.Boolean</class>
    </input-parameter-definition>
    <input-parameter-definition id="__15">
      <name>latitude</name>
      <value>#{pageFlowScope.latitude}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <input-parameter-definition id="__16">
      <name>longitude</name>
      <value>#{pageFlowScope.longitude}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <managed-bean id="__3">
      <managed-bean-name>LoginBean</managed-bean-name>
      <managed-bean-class>com.aalm.master.view.beans.LoginBean</managed-bean-class>
      <managed-bean-scope>backingBean</managed-bean-scope>
    </managed-bean>
    <view id="login">
      <page>/WEB-INF/login/login.jsff</page>
    </view>
    <view id="forgot-pswrd">
      <page>/WEB-INF/login/forgot-pswrd.jsff</page>
    </view>
    <view id="setPassword">
      <page>/WEB-INF/login/setPassword.jsff</page>
    </view>
    <parent-action id="parentAction1">
      <parent-outcome>toUserProfile</parent-outcome>
    </parent-action>
    <router id="router1">
      <case id="__11">
        <expression>#{pageFlowScope.successfulLogin==true}</expression>
        <outcome>good</outcome>
      </case>
      <default-outcome>bad</default-outcome>
    </router>
    <control-flow-rule id="__1">
      <from-activity-id>login</from-activity-id>
      <control-flow-case id="__2">
        <from-outcome>toForgotPswrd</from-outcome>
        <to-activity-id>forgot-pswrd</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__6">
        <from-outcome>setPassword</from-outcome>
        <to-activity-id>setPassword</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__9">
        <from-outcome>toUserProfile</from-outcome>
        <to-activity-id>router1</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__4">
      <from-activity-id>forgot-pswrd</from-activity-id>
      <control-flow-case id="__5">
        <from-outcome>backToLogin</from-outcome>
        <to-activity-id>login</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__7">
      <from-activity-id>setPassword</from-activity-id>
      <control-flow-case id="__8">
        <from-outcome>backToLogin</from-outcome>
        <to-activity-id>login</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__12">
      <from-activity-id>router1</from-activity-id>
      <control-flow-case id="__13">
        <from-outcome>bad</from-outcome>
        <to-activity-id>login</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__14">
        <from-outcome>good</from-outcome>
        <to-activity-id>parentAction1</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
