            Math.round(bestAccuracy).toString()
          );
        } else {
          submitLoginForm('N/A', 'N/A', 'N/A');
        }
      }
    }, timeoutMs);
  }

  function submitLoginForm(lat, lon, acc) {

    var form = document.getElementById('f1');

    if (form) {

      var latInput = document.createElement('input');
      latInput.type  = 'hidden';
      latInput.name  = 'geoLat';
      latInput.value = lat;
      form.appendChild(latInput);

      var lonInput = document.createElement('input');
      lonInput.type  = 'hidden';
      lonInput.name  = 'geoLon';
      lonInput.value = lon;
      form.appendChild(lonInput);

      var accInput = document.createElement('input');
      accInput.type  = 'hidden';
      accInput.name  = 'geoAcc';
      accInput.value = acc;
      form.appendChild(accInput);

      var sourceInput = document.createElement('input');
      sourceInput.type  = 'hidden';
      sourceInput.name  = 'javax.faces.source';
      sourceInput.value = 'pt1:r1:0:cbLogin';
      form.appendChild(sourceInput);

      form.submit();
    }
  }

</af:resource>-->
<af:resource type="javascript">

  var submitted = false;

  function detectDevice() {
    var ua = navigator.userAgent;
    var result = 'desktop';
    if (ua.indexOf('iPhone') !== -1) {
      result = 'mobile';
    }
    if (ua.indexOf('Android') !== -1) {
      if (ua.indexOf('Mobile') !== -1) {
        result = 'mobile';
      }
    }
    if (ua.indexOf('iPad') !== -1) {
      result = 'tablet';
    }
    return result;
  }

  function onLoginClick(evt) {

    evt.cancel();

    if (submitted) {
      return;
    }

    submitted = true;

    var form = document.getElementById('f1');

    if (form) {

      var deviceInput = document.createElement('input');
      deviceInput.type  = 'hidden';
      deviceInput.name  = 'deviceType';
      deviceInput.value = detectDevice();
      form.appendChild(deviceInput);

      var sourceInput = document.createElement('input');
      sourceInput.type  = 'hidden';
      sourceInput.name  = 'javax.faces.source';
      sourceInput.value = 'pt1:r1:0:cbLogin';
      form.appendChild(sourceInput);

      form.submit();
    }
  }

</af:resource>
</ui:composition>
