        if (!submitted) {
          submitted = true;
          submitLoginForm('N/A', 'N/A', 'N/A');
        }
      },

      {
        enableHighAccuracy: true,
        timeout: 5000,
        maximumAge: 0
      }
    );

    var timeoutMs = 5000;
    if (isIOS()) {
      timeoutMs = 2000;
    }

    fallbackTimer = window.setTimeout(function() {
      if (watchId != null) {
        navigator.geolocation.clearWatch(watchId);
        watchId = null;
