          return;
        }

        var isBetter = false;
        if (bestAccuracy === null) {
          isBetter = true;
        } else {
          var diff = bestAccuracy - accuracy;
          if (diff === Math.abs(diff)) {
            isBetter = true;
          }
        }

        if (isBetter) {
          bestAccuracy = accuracy;
          bestLat = lat;
          bestLon = lon;
