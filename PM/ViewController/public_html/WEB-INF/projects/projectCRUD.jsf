<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE html>
<f:view xmlns:f="http://java.sun.com/jsf/core" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
        xmlns:c="http://java.sun.com/jsp/jstl/core">
    <c:set var="viewcontrollerBundle" value="#{adfBundle['com.aalm.pm.view.AalmPmBndl']}"/>
    <af:document id="d1">
        <af:messages id="m1"/>
        <af:form id="f1">
            <af:panelHeader text="#{viewcontrollerBundle.NewEditProject}" id="ph1">
                <f:facet name="context"/>
                <f:facet name="menuBar">
                    <af:button text="#{viewcontrollerBundle.SAVE}" id="b2" action="toSave"/>
                </f:facet>
                <f:facet name="toolbar">
                    <af:button text="#{viewcontrollerBundle.cancel}" id="b1" action="toCancel" immediate="true"/>
                </f:facet>
                <f:facet name="legend"/>
                <af:panelFormLayout id="pfl1">
                    <af:inputText value="#{bindings.ProjId.inputValue}" label="#{bindings.ProjId.hints.label}"
                                  required="#{bindings.ProjId.hints.mandatory}"
                                  columns="#{bindings.ProjId.hints.displayWidth}"
                                  maximumLength="#{bindings.ProjId.hints.precision}"
                                  shortDesc="#{bindings.ProjId.hints.tooltip}" id="it1" disabled="true">
                        <f:validator binding="#{bindings.ProjId.validator}"/>
                        <af:convertNumber groupingUsed="false" pattern="#{bindings.ProjId.format}"/>
                    </af:inputText>
                    <af:inputText value="#{bindings.ProjCode.inputValue}" label="#{bindings.ProjCode.hints.label}"
                                  required="#{bindings.ProjCode.hints.mandatory}"
                                  columns="#{bindings.ProjCode.hints.displayWidth}"
                                  maximumLength="#{bindings.ProjCode.hints.precision}"
                                  shortDesc="#{bindings.ProjCode.hints.tooltip}" id="it2" contentStyle="width:150px;"
                                  readOnly="#{bindings.VersionNo.inputValue>0}">
                        <f:validator binding="#{bindings.ProjCode.validator}"/>
                    </af:inputText>
                    <af:inputDate value="#{bindings.ProjDt.inputValue}" label="#{bindings.ProjDt.hints.label}"
                                  required="#{bindings.ProjDt.hints.mandatory}"
                                  columns="#{bindings.ProjDt.hints.displayWidth}"
                                  shortDesc="#{bindings.ProjDt.hints.tooltip}" id="id1" contentStyle="width:200px;"
                                  readOnly="#{bindings.VersionNo.inputValue>0}">
                        <f:validator binding="#{bindings.ProjDt.validator}"/>
                        <af:convertDateTime pattern="#{bindings.ProjDt.format}"/>
                    </af:inputDate>
                    <af:inputText value="#{bindings.ProjName.inputValue}" label="#{bindings.ProjName.hints.label}"
                                  required="#{bindings.ProjName.hints.mandatory}"
                                  columns="#{bindings.ProjName.hints.displayWidth}"
                                  maximumLength="#{bindings.ProjName.hints.precision}"
                                  shortDesc="#{bindings.ProjName.hints.tooltip}" id="it3" contentStyle="width:400px;"
                                  readOnly="#{bindings.VersionNo.inputValue>0}">
                        <f:validator binding="#{bindings.ProjName.validator}"/>
                    </af:inputText>
                    <af:inputText value="#{bindings.Selected.inputValue}" label="#{bindings.Selected.hints.label}"
                                  required="#{bindings.Selected.hints.mandatory}"
                                  columns="#{bindings.Selected.hints.displayWidth}"
                                  maximumLength="#{bindings.Selected.hints.precision}"
                                  shortDesc="#{bindings.Selected.hints.tooltip}" id="it4" rendered="false">
                        <f:validator binding="#{bindings.Selected.validator}"/>
                    </af:inputText>
                    <af:selectOneChoice value="#{bindings.CustId.inputValue}" label="#{bindings.CustId.label}"
                                        required="#{bindings.CustId.hints.mandatory}"
                                        shortDesc="#{bindings.CustId.hints.tooltip}" id="soc1"
                                        contentStyle="min-width:350px;" readOnly="#{bindings.VersionNo.inputValue>0}">
                        <f:selectItems value="#{bindings.CustId.items}" id="si1"/>
                        <f:validator binding="#{bindings.CustId.validator}"/>
                    </af:selectOneChoice>
                    <af:panelLabelAndMessage label="#{bindings.VersionNo.hints.label}" id="plam1">
                        <af:outputText value="#{bindings.VersionNo.inputValue}"
                                       shortDesc="#{bindings.VersionNo.hints.tooltip}" id="ot1">
                            <af:convertNumber groupingUsed="false" pattern="#{bindings.VersionNo.format}"/>
                        </af:outputText>
                    </af:panelLabelAndMessage>
                </af:panelFormLayout>
                <f:facet name="info"/>
            </af:panelHeader>
        </af:form>
    </af:document>
</f:view>