<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="project_staff-TF">
    <template-reference>
      <document>/WEB-INF/page-gragment-template.xml</document>
      <id>page-gragment-template</id>
    </template-reference>
    <default-activity>ExecuteWithParams</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__1">
      <name>pProjId</name>
      <value>#{pageFlowScope.pProjId}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <input-parameter-definition id="__4">
      <name>pProjectName</name>
      <value>#{pageFlowScope.pProjectName}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <method-call id="ExecuteWithParams">
      <method>#{bindings.ExecuteWithParams.execute}</method>
      <outcome>
        <fixed-outcome>ExecuteWithParams</fixed-outcome>
      </outcome>
    </method-call>
    <view id="projectStaff">
      <page>/WEB-INF/projects/projectStaff.jsff</page>
    </view>
    <control-flow-rule id="__2">
      <from-activity-id>ExecuteWithParams</from-activity-id>
      <control-flow-case id="__3">
        <from-outcome>ExecuteWithParams</from-outcome>
        <to-activity-id>projectStaff</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
