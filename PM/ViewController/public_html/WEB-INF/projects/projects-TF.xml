<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="projects-TF">
    <template-reference>
      <document>/WEB-INF/page-gragment-template.xml</document>
      <id>page-gragment-template</id>
    </template-reference>
    <default-activity>projects</default-activity>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__10">
      <name>pProId</name>
      <value>#{pageFlowScope.pProjId}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <input-parameter-definition id="__11">
      <name>pProjCode</name>
      <value>#{pageFlowScope.pProjCode}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <input-parameter-definition id="__12">
      <name>pProjName</name>
      <value>#{pageFlowScope.pProjName}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <input-parameter-definition id="__14">
      <name>pVersionNo</name>
      <value>#{pageFlowScope.pVersionNo}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <input-parameter-definition id="__15">
      <name>pCustId</name>
      <value>#{pageFlowScope.pCustId}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <managed-bean id="__13">
      <managed-bean-name>PmBean</managed-bean-name>
      <managed-bean-class>com.aalm.pm.view.beans.PmBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="projects">
      <page>/WEB-INF/projects/projectsList.jsff</page>
    </view>
    <task-flow-call id="projects-pricing_TF">
      <task-flow-reference>
        <document>/WEB-INF/projects-pricing/projects-pricing_TF.xml</document>
        <id>projects-pricing_TF</id>
      </task-flow-reference>
      <input-parameter id="__4">
        <name>refreshRegion</name>
        <value>#{sessionScope.refreshRegion}</value>
      </input-parameter>
      <input-parameter id="__5">
        <name>refreshLocale</name>
        <value>#{sessionScope.refreshLocale}</value>
      </input-parameter>
      <input-parameter id="__9">
        <name>pProjCode</name>
        <value>#{pageFlowScope.pProjCode}</value>
      </input-parameter>
      <input-parameter id="__19">
        <name>pVerNo</name>
        <value>#{pageFlowScope.pVerNo}</value>
      </input-parameter>
    </task-flow-call>
    <task-flow-call id="project_crud-TF">
      <task-flow-reference>
        <document>/WEB-INF/projects/project_crud-TF.xml</document>
        <id>project_crud-TF</id>
      </task-flow-reference>
      <input-parameter id="__8">
        <name>pVerNo</name>
        <value>#{pageFlowScope.pVerNo}</value>
      </input-parameter>
      <input-parameter id="__18">
        <name>pProjCode</name>
        <value>#{pageFlowScope.pProjCode}</value>
      </input-parameter>
      <run-as-dialog>
        <display-type>
          <inline-popup/>
        </display-type>
      </run-as-dialog>
    </task-flow-call>
    <method-call id="Execute">
      <method>#{bindings.Execute.execute}</method>
      <outcome>
        <fixed-outcome>Execute</fixed-outcome>
      </outcome>
    </method-call>
    <control-flow-rule id="__1">
      <from-activity-id>projects</from-activity-id>
      <control-flow-case id="__2">
        <from-outcome>open_project</from-outcome>
        <to-activity-id>projects-pricing_TF</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__7">
        <from-outcome>toCrud</from-outcome>
        <to-activity-id>project_crud-TF</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__16">
      <from-activity-id>Execute</from-activity-id>
      <control-flow-case id="__17">
        <from-outcome>Execute</from-outcome>
        <to-activity-id>projects</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <use-page-fragments/>
  </task-flow-definition>
</adfc-config>
