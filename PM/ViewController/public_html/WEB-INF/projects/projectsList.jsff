<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core">
  <c:set var="viewcontrollerBundle" value="#{adfBundle['com.aalm.pm.view.AalmPmBndl']}"/>
  <af:panelTabbed position="above" id="pt1">
    <af:showDetailItem id="tab1" text="#{viewcontrollerBundle.PROJECTS}">
      <af:panelHeader text=" " id="ph1">
        <f:facet name="context"/>
        <f:facet name="menuBar">
          <af:button text="#{viewcontrollerBundle.SAVE}" id="b3" icon="#{resource['images:SaveF.png']}"
                     hoverIcon="#{resource['images:SaveO.png']}" actionListener="#{bindings.Commit.execute}"/>
        </f:facet>
        <f:facet name="toolbar">
          <af:button text="#{viewcontrollerBundle.cancel}" id="b2" icon="#{resource['images:cancelF.png']}"
                     hoverIcon="#{resource['images:cancelO.png']}" actionListener="#{bindings.Rollback.execute}"/>
        </f:facet>
        <f:facet name="legend"/>
        <af:panelCollection id="pc1" styleClass="AFStretchWidth">
          <f:facet name="menus"/>
          <f:facet name="toolbar"/>
          <f:facet name="statusbar"/>
          <af:table value="#{bindings.ProjectsListV.collectionModel}" var="row"
                    rows="#{bindings.ProjectsListV.rangeSize}"
                    emptyText="#{bindings.ProjectsListV.viewable ? 'No data to display.' : 'Access Denied.'}"
                    rowBandingInterval="0" selectedRowKeys="#{bindings.ProjectsListV.collectionModel.selectedRow}"
                    selectionListener="#{bindings.ProjectsListV.collectionModel.makeCurrent}" rowSelection="single"
                    fetchSize="#{bindings.ProjectsListV.rangeSize}"
                    filterModel="#{bindings.ProjectsListVQuery.queryDescriptor}"
                    queryListener="#{bindings.ProjectsListVQuery.processQuery}" filterVisible="true" varStatus="vs"
                    id="t1" partialTriggers="l2 ot1 :::b1 :::b2 :::b3">
            <af:column sortProperty="#{bindings.ProjectsListV.hints.ProjCode.name}" filterable="true" sortable="true"
                       headerText="#{bindings.ProjectsListV.hints.ProjCode.label}" id="c1">
              <af:outputText value="#{row.ProjId}" id="ot9" rendered="false"/>
              <af:panelGroupLayout id="pgl2" layout="horizontal">
                <af:link id="l2" icon="#{resource['images:delete24.png']}" visible="#{row.VerCount==0}"
                         actionListener="#{bindings.delete_project.execute}"
                         action="#{pageFlowScope.PmBean.delProjectActn}">
                  <af:setPropertyListener from="#{row.ProjId}" to="#{pageFlowScope.pProjId}" type="action"/>
                  <af:setPropertyListener from="#{'0'}" to="#{pageFlowScope.pVersionNo}" type="action"/>
                </af:link>
                <af:link shortDesc="#{bindings.ProjectsListV.hints.ProjCode.tooltip}" id="ot1" text="#{row.ProjCode}"
                         action="toCrud" useWindow="true" windowEmbedStyle="inlineDocument" windowHeight="300"
                         windowWidth="600" returnListener="#{pageFlowScope.PmBean.rtrnFromNewProjectLsnr}"
                         inlineStyle="text-decoration:underline;">
                  <af:setPropertyListener from="#{row.ProjCode}" to="#{pageFlowScope.pProjCode}" type="action"/>
                  <af:setPropertyListener from="#{row.VerCount}" to="#{pageFlowScope.pVerNo}" type="action"/>
                </af:link>
                <f:facet name="separator">
                  <af:spacer width="10" height="10" id="s2"/>
                </f:facet>
              </af:panelGroupLayout>
            </af:column>
            <af:column sortProperty="#{bindings.ProjectsListV.hints.ProjName.name}" filterable="true" sortable="true"
                       headerText="#{bindings.ProjectsListV.hints.ProjName.label}" id="c2" width="400">
              <af:outputText value="#{row.ProjName}" shortDesc="#{bindings.ProjectsListV.hints.ProjName.tooltip}"
                             id="ot2"/>
            </af:column>
            <af:column sortProperty="#{bindings.ProjectsListV.hints.ProjDt.name}" filterable="true" sortable="true"
                       headerText="#{bindings.ProjectsListV.hints.ProjDt.label}" id="c3" width="120">
              <f:facet name="filter">
                <af:inputDate value="#{bindings.ProjectsListVQuery.queryDescriptor.filterConjunctionCriterion.criterionMap.ProjDt.value}"
                              id="id1">
                  <af:convertDateTime pattern="#{bindings.ProjectsListV.hints.ProjDt.format}"/>
                </af:inputDate>
              </f:facet>
              <af:outputText value="#{row.ProjDt}" shortDesc="#{bindings.ProjectsListV.hints.ProjDt.tooltip}" id="ot3">
                <af:convertDateTime pattern="#{bindings.ProjectsListV.hints.ProjDt.format}"/>
              </af:outputText>
            </af:column>
            <af:column sortProperty="#{bindings.ProjectsListV.hints.CustId.name}" filterable="true" sortable="true"
                       headerText="#{bindings.ProjectsListV.hints.CustId.label}" id="c4" width="300">
              <af:selectOneChoice value="#{row.bindings.CustId.inputValue}" label="#{row.bindings.CustId.label}"
                                  required="#{bindings.ProjectsListV.hints.CustId.mandatory}"
                                  shortDesc="#{bindings.ProjectsListV.hints.CustId.tooltip}" readOnly="true" id="soc1">
                <f:selectItems value="#{row.bindings.CustId.items}" id="si1"/>
                <f:validator binding="#{row.bindings.CustId.validator}"/>
              </af:selectOneChoice>
            </af:column>
            <af:column sortProperty="#{bindings.ProjectsListV.hints.ProjId.name}" filterable="true" sortable="true"
                       headerText="#{bindings.ProjectsListV.hints.ProjId.label}" id="c5" rendered="false">
              <af:outputText value="#{row.ProjId}" shortDesc="#{bindings.ProjectsListV.hints.ProjId.tooltip}" id="ot4">
                <af:convertNumber groupingUsed="false" pattern="#{bindings.ProjectsListV.hints.ProjId.format}"/>
              </af:outputText>
            </af:column>
            <af:column sortProperty="#{bindings.ProjectsListV.hints.Selected.name}" filterable="true" sortable="true"
                       headerText="#{bindings.ProjectsListV.hints.Selected.label}" id="c6" rendered="false">
              <af:outputText value="#{row.Selected}" shortDesc="#{bindings.ProjectsListV.hints.Selected.tooltip}"
                             id="ot5"/>
            </af:column>
            <af:column sortProperty="#{bindings.ProjectsListV.hints.VerCount.name}" filterable="true" sortable="true"
                       headerText="#{bindings.ProjectsListV.hints.VerCount.label}" id="c7" width="300">
              <af:panelGroupLayout id="pgl1" layout="horizontal">
                <af:link shortDesc="#{bindings.ProjectsListV.hints.VerCount.tooltip}" id="ot6" text="#{row.VerCount}"
                         icon="#{resource['images:CreateF.png']}" hoverIcon="#{resource['images:CreateO.png']}"
                         action="open_project">
                  <af:setPropertyListener from="#{row.ProjCode}" to="#{pageFlowScope.pProjCode}" type="action"/>
                  <af:setPropertyListener from="#{row.VerCount}" to="#{pageFlowScope.pVerNo}" type="action"/>
                </af:link>
                <f:facet name="separator">
                  <af:spacer width="10" height="10" id="s1"/>
                </f:facet>
                <af:link text="#{viewcontrollerBundle.OldVersions}" id="l1" icon="#{resource['images:3Hdotsf.png']}"
                         hoverIcon="#{resource['images:3Hdotso.png']}" visible="#{row.VerCount>0}">
                  <af:showPopupBehavior popupId=":::p1" triggerType="action" align="afterEnd" alignId="l1"/>
                </af:link>
              </af:panelGroupLayout>
            </af:column>
            <af:column sortProperty="#{bindings.ProjectsListV.hints.DetCount.name}" filterable="true" sortable="true"
                       headerText="#{bindings.ProjectsListV.hints.DetCount.label}" id="c8" rendered="false">
              <af:outputText value="#{row.DetCount}" shortDesc="#{bindings.ProjectsListV.hints.DetCount.tooltip}"
                             id="ot7">
                <af:convertNumber groupingUsed="false" pattern="#{bindings.ProjectsListV.hints.DetCount.format}"/>
              </af:outputText>
            </af:column>
            <af:column sortProperty="#{bindings.ProjectsListV.hints.OverheadPerc.name}" filterable="true"
                       sortable="true" headerText="#{bindings.ProjectsListV.hints.OverheadPerc.label}" id="c9"
                       rendered="false">
              <af:outputText value="#{row.OverheadPerc}"
                             shortDesc="#{bindings.ProjectsListV.hints.OverheadPerc.tooltip}" id="ot8">
                <af:convertNumber groupingUsed="false" pattern="#{bindings.ProjectsListV.hints.OverheadPerc.format}"/>
              </af:outputText>
            </af:column>
          </af:table>
        </af:panelCollection>
        <f:facet name="info">
          <af:button text="#{viewcontrollerBundle.NEW}" id="b1" action="toCrud" useWindow="true"
                     windowEmbedStyle="inlineDocument" windowHeight="300" windowWidth="600"
                     returnListener="#{pageFlowScope.PmBean.rtrnFromNewProjectLsnr}" partialSubmit="false">
            <af:setPropertyListener from="#{null}" to="#{pageFlowScope.pProjCode}" type="action"/>
          </af:button>
        </f:facet>
      </af:panelHeader>
      <af:popup autoCancel="disabled" id="p1" contentDelivery="lazyUncached" childCreation="deferred">
        <af:noteWindow id="nw1" inlineStyle="max-width:150px;">
          <af:panelHeader text="#{viewcontrollerBundle.OldVersions}" id="ph2">
            <f:facet name="context"/>
            <f:facet name="menuBar"/>
            <f:facet name="toolbar"/>
            <f:facet name="legend"/>
            <af:table value="#{bindings.ProjectVersionsV.collectionModel}" var="row"
                      rows="#{bindings.ProjectVersionsV.rangeSize}"
                      emptyText="#{bindings.ProjectVersionsV.viewable ? 'No data to display.' : 'Access Denied.'}"
                      rowBandingInterval="0" selectedRowKeys="#{bindings.ProjectVersionsV.collectionModel.selectedRow}"
                      selectionListener="#{bindings.ProjectVersionsV.collectionModel.makeCurrent}" rowSelection="single"
                      fetchSize="#{bindings.ProjectVersionsV.rangeSize}"
                      filterModel="#{bindings.ProjectVersionsVQuery.queryDescriptor}"
                      queryListener="#{bindings.ProjectVersionsVQuery.processQuery}" filterVisible="true" varStatus="vs"
                      id="t2" width="120" columnStretching="column:c11">
              <af:column sortProperty="#{bindings.ProjectVersionsV.hints.ProjId.name}" filterable="true" sortable="true"
                         headerText="#{bindings.ProjectVersionsV.hints.ProjId.label}" id="c10" rendered="false">
                <af:outputText value="#{row.ProjId}" shortDesc="#{bindings.ProjectVersionsV.hints.ProjId.tooltip}"
                               id="ot10">
                  <af:convertNumber groupingUsed="false" pattern="#{bindings.ProjectVersionsV.hints.ProjId.format}"/>
                </af:outputText>
              </af:column>
              <af:column sortProperty="#{bindings.ProjectVersionsV.hints.VersionNo.name}" filterable="true"
                         sortable="true" headerText="#{bindings.ProjectVersionsV.hints.VersionNo.label}" id="c11"
                         width="120" align="center">
                <af:panelGroupLayout id="pgl3" layout="horizontal">
                  <af:outputText value="#{row.ProjId}--#{row.ProjCode}" id="ot12" rendered="false"/>
                  <af:link shortDesc="#{bindings.ProjectVersionsV.hints.VersionNo.tooltip}" id="ot11"
                           text="#{row.VersionNo}" action="open_project"
                           inlineStyle="font-size:30px; text-decoration:underline solid currentColor;">
                    <af:setPropertyListener from="#{row.ProjCode}" to="#{pageFlowScope.pProjCode}" type="action"/>
                    <af:setPropertyListener from="#{row.VersionNo}" to="#{pageFlowScope.pVerNo}" type="action"/>
                  </af:link>
                  <f:facet name="separator">
                    <af:spacer width="10" height="10" id="s3"/>
                  </f:facet>
                  <af:link id="l3" icon="#{resource['images:delete24.png']}" rendered="false"/>
                </af:panelGroupLayout>
              </af:column>
            </af:table>
            <f:facet name="info"/>
          </af:panelHeader>
        </af:noteWindow>
      </af:popup>
    </af:showDetailItem>
    <af:showDetailItem id="tab2" text="#{viewcontrollerBundle.ProjectStaff}">
      <af:tree value="#{bindings.ProjectStaffTreeV.treeModel}" var="node"
               selectionListener="#{bindings.ProjectStaffTreeV.treeModel.makeCurrent}" rowSelection="single" id="t3">
        <f:facet name="nodeStamp">
          <af:outputText value="#{node}" id="ot13" inlineStyle="min-width:200px; font-size:20px;"/>
        </f:facet>
      </af:tree>
    </af:showDetailItem>
  </af:panelTabbed>
</ui:composition>
