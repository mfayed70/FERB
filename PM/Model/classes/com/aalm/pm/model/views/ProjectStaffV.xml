  <SQLQuery><![CDATA[SELECT
    j.job_id,

    CASE
        WHEN ? = 'ar' THEN j.job_name_ar
        ELSE j.job_name_en
    END AS job_name,

    j.parent_job_id,
    h.proj_id, h.version_no,
    p.proj_name,
    h.frm_dt,
    h.to_dt

FROM JOBS j
LEFT JOIN EMPLOYEE_JOB_HISTORY h
       ON h.job_id = j.job_id
      AND h.to_dt IS NULL
LEFT JOIN PROJECTS_MAST p
       ON p.proj_id = h.proj_id
      AND p.version_no = h.version_no
WHERE EXISTS
(
    SELECT 1
    FROM ORGANIZATIONS o
    WHERE o.org_code = j.org_code
   /*   AND o.org_type = 'D' */
)

ORDER BY
    COALESCE(j.parent_job_id, j.job_id),
    j.job_id]]></SQLQuery>
