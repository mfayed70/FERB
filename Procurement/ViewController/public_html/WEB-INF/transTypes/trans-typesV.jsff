<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core">
  <c:set var="viewcontrollerBundle" value="#{adfBundle['com.aalm.prcrmnt.view.AalmPrcrmntBndl']}"/>
  <af:panelHeader text="#{viewcontrollerBundle.PurchaseTransactionsTypes}" id="ph1">
    <f:facet name="context"/>
    <f:facet name="menuBar">
      <af:button actionListener="#{bindings.Commit.execute}" text="#{viewcontrollerBundle.SAVE}"
                 id="b3" icon="#{resource['images:SaveF.png']}" hoverIcon="#{resource['images:SaveO.png']}"/>
    </f:facet>
    <f:facet name="toolbar">
      <af:button actionListener="#{bindings.Rollback.execute}" text="#{viewcontrollerBundle.CANCEL}"
                 immediate="true" id="b2" icon="#{resource['images:cancelF.png']}"
                 hoverIcon="#{resource['images:cancelO.png']}">
        <af:resetActionListener/>
      </af:button>
    </f:facet>
    <f:facet name="legend"/>
    <af:panelFormLayout id="pfl1">
      <af:inputText value="#{bindings.PrTransTypeCode.inputValue}" label="#{bindings.PrTransTypeCode.hints.label}"
                    required="#{bindings.PrTransTypeCode.hints.mandatory}"
                    columns="#{bindings.PrTransTypeCode.hints.displayWidth}"
                    maximumLength="#{bindings.PrTransTypeCode.hints.precision}"
                    shortDesc="#{bindings.PrTransTypeCode.hints.tooltip}" id="it1">
        <f:validator binding="#{bindings.PrTransTypeCode.validator}"/>
        <af:convertNumber groupingUsed="false" pattern="#{bindings.PrTransTypeCode.format}"/>
      </af:inputText>
      <af:inputText value="#{bindings.PrTransNameE.inputValue}" label="#{bindings.PrTransNameE.hints.label}"
                    required="#{bindings.PrTransNameE.hints.mandatory}"
                    columns="#{bindings.PrTransNameE.hints.displayWidth}"
                    maximumLength="#{bindings.PrTransNameE.hints.precision}"
                    shortDesc="#{bindings.PrTransNameE.hints.tooltip}" id="it2" contentStyle="width:300px;">
        <f:validator binding="#{bindings.PrTransNameE.validator}"/>
      </af:inputText>
      <af:inputText value="#{bindings.PrTransNameA.inputValue}" label="#{bindings.PrTransNameA.hints.label}"
                    required="#{bindings.PrTransNameA.hints.mandatory}"
                    columns="#{bindings.PrTransNameA.hints.displayWidth}"
                    maximumLength="#{bindings.PrTransNameA.hints.precision}"
                    shortDesc="#{bindings.PrTransNameA.hints.tooltip}" id="it3" contentStyle="width:300px;">
        <f:validator binding="#{bindings.PrTransNameA.validator}"/>
      </af:inputText>
      <af:selectOneRadio value="#{bindings.PrTransType.inputValue}" label="#{bindings.PrTransType.label}"
                         required="#{bindings.PrTransType.hints.mandatory}"
                         shortDesc="#{bindings.PrTransType.hints.tooltip}" id="sor1">
        <f:selectItems value="#{bindings.PrTransType.items}" id="si1"/>
        <f:validator binding="#{bindings.PrTransType.validator}"/>
      </af:selectOneRadio>
      <af:selectBooleanCheckbox value="#{bindings.Active.inputValue}" label="#{bindings.Active.label}"
                                shortDesc="#{bindings.Active.hints.tooltip}" id="sbc1"/>
    </af:panelFormLayout>
    <f:facet name="info">
      <af:button actionListener="#{bindings.CreateInsert.execute}" text="#{viewcontrollerBundle.NEW}" id="b1" icon="#{resource['images:NewF.png']}"
                 hoverIcon="#{resource['images:NewO.png']}"/>
    </f:facet>
  </af:panelHeader>
</ui:composition>
