<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core">
  <c:set var="viewcontrollerBundle" value="#{adfBundle['com.aalm.prcrmnt.view.AalmPrcrmntBndl']}"/>
  <af:panelHeader text="#{viewcontrollerBundle.MaterialRequestsList}" id="ph1">
    <f:facet name="context"/>
    <f:facet name="menuBar"/>
    <f:facet name="toolbar"/>
    <f:facet name="legend"/>
    <af:panelLabelAndMessage label="#{bindings.PurMatRqstId.hints.label}" id="plam1" labelStyle="vertical-align:top;">
      <af:link id="of1" text="#{bindings.PurMatRqstId.inputValue}" action="review"/>
    </af:panelLabelAndMessage>
    <f:facet name="info"/>
  </af:panelHeader>
</ui:composition>
