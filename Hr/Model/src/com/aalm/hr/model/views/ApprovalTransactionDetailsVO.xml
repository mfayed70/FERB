  <SQLQuery><![CDATA[SELECT ApprovalTransactionDetails.DETAIL_ID, 
       ApprovalTransactionDetails.APPROVAL_TRANS_ID, 
       ApprovalTransactionDetails.STEP_ID, 
       ApprovalTransactionDetails.APPROVER_ID, 
       ApprovalTransactionDetails.ACTION_STATUS, 
       ApprovalTransactionDetails.ACTION_DATE, 
       ApprovalTransactionDetails.COMMENTS, 
       ApprovalTransactionDetails.APPROVAL_ORDER, 
       ApprovalTransactionDetails.IS_ACTIVE, 
       ApprovalTransactionDetails.ROLE_ID,
       -- Display columns from related tables (read-only)
    a.transaction_ref_id,
    a.module_name,
    a.request_date,
    a.status AS transaction_status,
    a.requested_by,

    -- From APPROVAL_CYCLE_TYPES
    act.transaction_type_name,
    
    -- Requester info
    e_req.emp_name AS requester_name,
    j_req.job_name_en AS requester_job,

    -- Approver info
    e_app.emp_name AS approver_name,
    j_app.job_name_en AS approver_job,
    e_app.org_code AS approver_org_code,

    -- Role info
    r.role_name
       
FROM  APPROVAL_TRANSACTION_DETAILS ApprovalTransactionDetails
    JOIN APPROVAL_TRANSACTIONS a ON ApprovalTransactionDetails.approval_trans_id = a.approval_trans_id
     JOIN APPROVAL_CYCLE_TYPES act ON a.cycle_type_id = act.cycle_type_id
    JOIN EMPLOYEES e_req ON a.requested_by = e_req.emp_id
    JOIN JOBS j_req ON e_req.job_id = j_req.job_id
    JOIN EMPLOYEES e_app ON ApprovalTransactionDetails.approver_id = e_app.emp_id
    JOIN JOBS j_app ON e_app.job_id = j_app.job_id
    JOIN APPROVAL_ROLES r ON ApprovalTransactionDetails.role_id = r.role_id
WHERE ApprovalTransactionDetails.is_active = 1
  AND  ApprovalTransactionDetails.action_status = 'PENDING'
ORDER BY
    a.request_date DESC,
    ApprovalTransactionDetails.approval_order ASC]]></SQLQuery>
