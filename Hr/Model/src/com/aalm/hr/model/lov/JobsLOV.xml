<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE ViewObject SYSTEM "jbo_03_01.dtd">
<!---->
<ViewObject
  xmlns="http://xmlns.oracle.com/bc4j"
  Name="JobsLOV"
  Version="12.1.3.10.47"
  InheritPersonalization="merge"
  BindingStyle="JDBC"
  CustomQuery="true"
  PageIterMode="Full"
  FetchMode="FETCH_ALL"
  RangeSize="-1"
  MaxFetchSize="120">
  <DesignTime>
    <Attr Name="_isExpertMode" Value="true"/>
  </DesignTime>
  <Properties>
    <SchemaBasedProperties>
      <LABEL
        ResId="com.aalm.hr.model.lov.JobsLOV_LABEL"/>
    </SchemaBasedProperties>
  </Properties>
  <Variable
    Name="bndLocale"
    Kind="where"
    Type="java.lang.String">
    <AttrArray Name="ExtendedDataInts">
      <Item Value="0"/>
    </AttrArray>
    <TransientExpression
      trustMode="untrusted"
      Name="expression"><![CDATA[adf.context.sessionScope.refreshLocale]]></TransientExpression>
  </Variable>
  <SQLQuery><![CDATA[SELECT 
    j.job_id,
    j.org_code,
    CASE ?
   WHEN 'en' THEN CONCAT(o.en_org_name,'/',j.job_name_en)
   WHEN 'ar' THEN CONCAT(o.ar_org_name,'/',j.job_name_ar)
   ELSE CONCAT(o.en_org_name,'/',j.job_name_en)
END AS job_name
FROM 
    JOBS j
JOIN ORGANIZATIONS o
    ON j.org_code = o.org_code]]></SQLQuery>
  <ViewAttribute
    Name="JobId"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.lang.Integer"
    ColumnType="INTEGER"
    AliasName="job_id"
    Expression="job_id"
    SQLType="INTEGER">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="11"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="OrgCode"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Type="java.lang.Integer"
    ColumnType="INT"
    AliasName="org_code"
    Expression="org_code"
    SQLType="INTEGER">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="11"/>
    </DesignTime>
  </ViewAttribute>
  <ViewAttribute
    Name="JobName"
    IsUpdateable="false"
    IsPersistent="false"
    PrecisionRule="true"
    Precision="201"
    Type="java.lang.String"
    ColumnType="VARCHAR"
    AliasName="job_name"
    Expression="job_name"
    SQLType="VARCHAR">
    <DesignTime>
      <Attr Name="_DisplaySize" Value="201"/>
    </DesignTime>
  </ViewAttribute>
  <AttrArray Name="KeyAttributes">
    <Item Value="JobId"/>
  </AttrArray>
  <ResourceBundle>
    <XliffBundle
      id="com.aalm.hr.model.AalmHrMBndl"/>
  </ResourceBundle>
</ViewObject>
