<?xml version='1.0' encoding='UTF-8'?>
<ui:composition xmlns:ui="http://java.sun.com/jsf/facelets" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
                xmlns:f="http://java.sun.com/jsf/core" xmlns:c="http://java.sun.com/jsp/jstl/core"
                xmlns:dvt="http://xmlns.oracle.com/dss/adf/faces">
  <c:set var="viewcontrollerBundle" value="#{adfBundle['com.aalm.hr.view.AalmHrBndl']}"/>
  <af:panelHeader text="#{pageFlowScope.pViewForUser ? viewcontrollerBundle.YourProfile : viewcontrollerBundle.EmployeeProfile}" id="ph1">
    <f:facet name="context">
      <af:panelDrawer id="pd1"/>
    </f:facet>
    <f:facet name="menuBar"/>
    <f:facet name="toolbar"/>
    <f:facet name="legend"/>
    <af:table value="#{bindings.OrgUsersV.collectionModel}" var="row" rows="#{bindings.OrgUsersV.rangeSize}"
              emptyText="#{bindings.OrgUsersV.viewable ? 'No data to display.' : 'Access Denied.'}"
              rowBandingInterval="0" selectedRowKeys="#{bindings.OrgUsersV.collectionModel.selectedRow}"
              selectionListener="#{bindings.OrgUsersV.collectionModel.makeCurrent}" rowSelection="single"
              fetchSize="#{bindings.OrgUsersV.rangeSize}" filterModel="#{bindings.OrgUsersVQuery.queryDescriptor}"
              queryListener="#{bindings.OrgUsersVQuery.processQuery}" filterVisible="true" varStatus="vs" id="t1"
              rendered="#{!pageFlowScope.pViewForUser}" verticalGridVisible="false">
      <af:column sortProperty="#{bindings.OrgUsersV.hints.EmpId.name}" filterable="true" sortable="true"
                 headerText="#{bindings.OrgUsersV.hints.EmpId.label}" id="c4" width="150">
        <af:inputText value="#{row.bindings.EmpId.inputValue}" shortDesc="#{bindings.OrgUsersV.hints.EmpId.tooltip}"
                      id="ot4" label="#{bindings.OrgUsersV.hints.EmpId.label}" simple="true"
                      required="#{bindings.OrgUsersV.hints.EmpId.mandatory}"
                      columns="#{bindings.OrgUsersV.hints.EmpId.displayWidth}"
                      maximumLength="#{bindings.OrgUsersV.hints.EmpId.precision}">
          <f:validator binding="#{row.bindings.EmpId.validator}"/>
          <af:convertNumber groupingUsed="false" pattern="#{bindings.OrgUsersV.hints.EmpId.format}"/>
        </af:inputText>
      </af:column>
      <af:column sortProperty="#{bindings.OrgUsersV.hints.FirstName.name}" filterable="true" sortable="true"
                 headerText="#{bindings.OrgUsersV.hints.FirstName.label}" id="c2" width="201">
        <af:inputText value="#{row.bindings.FirstName.inputValue}"
                      shortDesc="#{bindings.OrgUsersV.hints.FirstName.tooltip}" id="ot2"
                      label="#{bindings.OrgUsersV.hints.FirstName.label}" simple="true"
                      required="#{bindings.OrgUsersV.hints.FirstName.mandatory}"
                      columns="#{bindings.OrgUsersV.hints.FirstName.displayWidth}"
                      maximumLength="#{bindings.OrgUsersV.hints.FirstName.precision}">
          <f:validator binding="#{row.bindings.FirstName.validator}"/>
        </af:inputText>
      </af:column>
      <af:column sortProperty="#{bindings.OrgUsersV.hints.LastName.name}" filterable="true" sortable="true"
                 headerText="#{bindings.OrgUsersV.hints.LastName.label}" id="c3" width="199">
        <af:inputText value="#{row.bindings.LastName.inputValue}"
                      shortDesc="#{bindings.OrgUsersV.hints.LastName.tooltip}" id="ot3"
                      label="#{bindings.OrgUsersV.hints.LastName.label}" simple="true"
                      required="#{bindings.OrgUsersV.hints.LastName.mandatory}"
                      columns="#{bindings.OrgUsersV.hints.LastName.displayWidth}"
                      maximumLength="#{bindings.OrgUsersV.hints.LastName.precision}">
          <f:validator binding="#{row.bindings.LastName.validator}"/>
        </af:inputText>
      </af:column>
      <af:column sortProperty="#{bindings.OrgUsersV.hints.OrgCode.name}" filterable="true" sortable="true"
                 headerText="#{bindings.OrgUsersV.hints.OrgCode.label}" id="c41">
        <af:outputText value="#{row.OrgCode}" shortDesc="#{bindings.OrgUsersV.hints.OrgCode.tooltip}" id="ot33">
          <af:convertNumber groupingUsed="false" pattern="#{bindings.OrgUsersV.hints.OrgCode.format}"/>
        </af:outputText>
      </af:column>
    </af:table>
    <f:facet name="info"/>
    <af:spacer width="10" height="10" id="s1"/>
    <af:panelGroupLayout id="pgl4" layout="vertical">
      <af:panelTabbed id="pt1">
        <af:showDetailItem id="tab1" text="#{viewcontrollerBundle.YourAttendance}"
                           badge="#{viewcontrollerBundle.YourAttendance}">
          <af:panelSplitter id="ps2" orientation="vertical" splitterPosition="342" disabled="true"
                            inlineStyle="margin-right:5px;padding-left:100px;">
            <f:facet name="first">
              <af:panelSplitter id="ps4" splitterPosition="500" disabled="true">
                <f:facet name="first">
                  <dvt:pieChart id="pieChart1" var="row" value="#{bindings.AttendanceStatisticsV.collectionModel}"
                                threeDEffect="on" footnoteHalign="center" inlineStyle="width:500px;font-size:30px;"
                                sliceLabelPosition="inside" titleHalign="center" emptyText="Employee Attendance Chart"
                                title="Employee Attendance Chart" hideAndShowBehavior="withRescale"
                                sliceLabelStyle="font-size:10px;"
                                subtitle="#{bindings.CurrentYear.inputValue}#{' '}#{bindings.CurrMonth.inputValue}">
                    <dvt:chartLegend id="cl1" position="bottom"/>
                    <dvt:pieDataItem id="di1" value="#{row.TotalDays}" label="#{row.Status}" explode="0.1"
                                     sliceLabel="#{row.TotalDays}#{' Days'}"/>
                  </dvt:pieChart>
                </f:facet>
                <f:facet name="second">
                  <af:panelGroupLayout id="pgl11" layout="vertical" styleClass="AFStretchWidth"> 
    <af:panelBox id="pb1"
                 text="Your Current Location"
                 showDisclosure="false">
                      <!--Location display area-->
                      <af:panelGroupLayout id="locationPanel" layout="horizontal">

        <af:outputText id="otStatus"
                       value="#{sessionScope.Locale.locationStatus}"/>

        <af:outputText id="otLat"
                       label="Latitude"
                       value="#{sessionScope.Locale.latitude}"/>
<af:outputText id="otLon"
                       label="Longitude"
                       value="#{sessionScope.Locale.longitude}"/>

        <af:outputText id="otAcc"
                       label="Accuracy"
                       value="#{sessionScope.Locale.formattedAccuracy}"/>
                      </af:panelGroupLayout>

       <!--Hidden inputs carry geo values to server on each poll--> 
      <af:inputText id="itLat"
                    simple="true"
                    inlineStyle="display:none;" value="#{sessionScope.Locale.latitude}"/>

      <af:inputText id="itLon"
                    simple="true"
                    inlineStyle="display:none;" value="#{sessionScope.Locale.longitude}"/>

      <f:verbatim>
        <input type="hidden"
               id="accHidden"
               name="accHidden"
               value=""/>
      </f:verbatim>

    </af:panelBox>

    <af:separator id="s11"/>
                    <af:outputText value="#{sessionScope.deviceType}" id="ot1"/>
                    <af:panelGroupLayout id="pgl12" layout="vertical" styleClass="AFStretchWidth">
                      <af:outputText value="Your Location on Map:" id="otMapLabel" inlineStyle="font-size:14px;font-weight:bold;
                                padding:8px;display:block;"/>
                      <af:outputText id="osmUrl" value="#{sessionScope.Locale.openStreetMapUrl}"
                                     inlineStyle="display:none;"/>
                      <af:inlineFrame id="mapFrame"
                clientComponent="true"
                shortDesc="Current Location Map"
                width="600"
                height="400"
                inlineStyle="width:600px;height:400px;border:1px solid #CCCCCC;"/>

                      <!--<af:poll id="poll1" interval="#{sessionScope.Locale.accuracy eq null ? 5000 : -1}" timeout="15000"
                               partialTriggers="poll1" pollListener="#{sessionScope.Locale.onPoll}"/>-->
                      <!-- Poll inside jsff — same scope as all components above -->
                    </af:panelGroupLayout>
                  </af:panelGroupLayout>
                </f:facet>
              </af:panelSplitter>
            </f:facet>
            <f:facet name="second">
              <af:panelGroupLayout id="pgl3" layout="vertical" halign="center">
                <af:table value="#{bindings.AttendanceV.collectionModel}" var="row"
                          rows="#{bindings.AttendanceV.rangeSize}"
                          emptyText="#{bindings.AttendanceV.viewable ? 'No data to display.' : 'Access Denied.'}"
                          rowBandingInterval="0" selectedRowKeys="#{bindings.AttendanceV.collectionModel.selectedRow}"
                          selectionListener="#{bindings.AttendanceV.collectionModel.makeCurrent}" rowSelection="single"
                          fetchSize="#{bindings.AttendanceV.rangeSize}" id="t2" verticalGridVisible="false">
                  <af:column headerText="#{viewcontrollerBundle.SER_}" id="c1" width="30">
                    <af:inputText value="#{row.index+1}" label="#{bindings.AttendanceV.hints.AttendanceDate.label}"
                                  required="#{bindings.AttendanceV.hints.AttendanceDate.mandatory}"
                                  columns="#{bindings.AttendanceV.hints.AttendanceDate.displayWidth}"
                                  maximumLength="#{bindings.AttendanceV.hints.AttendanceDate.precision}"
                                  shortDesc="#{bindings.AttendanceV.hints.AttendanceDate.tooltip}" id="it1"
                                  readOnly="true"/>
                  </af:column>
                  <af:column headerText="#{bindings.AttendanceV.hints.AttendanceDate.label}" id="c5">
                    <af:inputDate value="#{row.bindings.AttendanceDate.inputValue}"
                                  label="#{bindings.AttendanceV.hints.AttendanceDate.label}"
                                  required="#{bindings.AttendanceV.hints.AttendanceDate.mandatory}"
                                  columns="#{bindings.AttendanceV.hints.AttendanceDate.displayWidth}"
                                  shortDesc="#{bindings.AttendanceV.hints.AttendanceDate.tooltip}" id="id1"
                                  readOnly="true">
                      <f:validator binding="#{row.bindings.AttendanceDate.validator}"/>
                      <af:convertDateTime pattern="#{bindings.AttendanceV.hints.AttendanceDate.format}" type="date"
                                          dateStyle="medium"/>
                    </af:inputDate>
                  </af:column>
                  <af:column headerText="#{viewcontrollerBundle.ATTENDANCE_DAY}" id="c6" align="center">
                    <af:inputDate value="#{row.bindings.AttendanceDate.inputValue}"
                                  label="#{bindings.AttendanceV.hints.AttendanceDate.label}"
                                  required="#{bindings.AttendanceV.hints.AttendanceDate.mandatory}"
                                  columns="#{bindings.AttendanceV.hints.AttendanceDate.displayWidth}"
                                  shortDesc="#{bindings.AttendanceV.hints.AttendanceDate.tooltip}" id="id2"
                                  readOnly="true">
                      <f:validator binding="#{row.bindings.AttendanceDate.validator}"/>
                      <af:convertDateTime pattern="EEEE"/>
                    </af:inputDate>
                  </af:column>
                  <af:column headerText="#{bindings.AttendanceV.hints.CheckInTime.label}" id="c7" align="center"
                             width="120">
                    <af:panelGroupLayout id="pgl1" layout="horizontal" visible="#{row.CheckInTime != null}">
                      <af:image id="i1" source="#{resource['images:punci-in-O.png']}"/>
                      <af:inputDate value="#{row.bindings.CheckInTime.inputValue}"
                                    label="#{bindings.AttendanceV.hints.CheckInTime.label}"
                                    required="#{bindings.AttendanceV.hints.CheckInTime.mandatory}"
                                    columns="#{bindings.AttendanceV.hints.CheckInTime.displayWidth}"
                                    shortDesc="#{bindings.AttendanceV.hints.CheckInTime.tooltip}" id="id3"
                                    readOnly="true">
                        <af:convertDateTime pattern="#{bindings.AttendanceV.hints.CheckInTime.format}" type="time"
                                            timeStyle="short"/>
                      </af:inputDate>
                      <f:facet name="separator">
                        <af:spacer width="5" height="10" id="s2"/>
                      </f:facet>
                    </af:panelGroupLayout>
                    <af:button text="#{viewcontrollerBundle.Punchin}" id="b1"
                               icon="#{resource['images:punci-in-O.png']}"
                               hoverIcon="#{resource['images:punci-in-F.png']}"
                               visible="#{row.AttendanceDate == row.CurrDate &amp;&amp; row.CheckInTime == null &amp;&amp; view.viewId=='/userProfile'}"
                               actionListener="#{pageFlowScope.HrBean.punchinBtnActnLsnr}" styleClass="but"
                               inlineStyle="background-color:#42c6ff;"
                               disabled="#{sessionScope.deviceType ne 'mobile'}">
                      <af:setPropertyListener from="#{'Punch-in'}" to="#{sessionScope.attendance}" type="action"/>
                    </af:button>
                  </af:column>
                  <af:column headerText="#{bindings.AttendanceV.hints.CheckOutTime.label}" id="c8" align="center"
                             width="120">
                    <af:panelGroupLayout id="pgl2" layout="horizontal" visible="#{row.CheckOutTime != null}">
                      <af:image id="i2" source="#{resource['images:punch-out-O.png']}"/>
                      <af:inputDate value="#{row.bindings.CheckOutTime.inputValue}"
                                    label="#{bindings.AttendanceV.hints.CheckOutTime.label}"
                                    required="#{bindings.AttendanceV.hints.CheckOutTime.mandatory}"
                                    columns="#{bindings.AttendanceV.hints.CheckOutTime.displayWidth}"
                                    shortDesc="#{bindings.AttendanceV.hints.CheckOutTime.tooltip}" id="id4"
                                    readOnly="true">
                        <af:convertDateTime pattern="#{bindings.AttendanceV.hints.CheckOutTime.format}" type="time"
                                            timeStyle="short"/>
                      </af:inputDate>
                      <f:facet name="separator">
                        <af:spacer width="5" height="10" id="s3"/>
                      </f:facet>
                    </af:panelGroupLayout>
                    <af:button text="#{viewcontrollerBundle.Punchout}" id="b2"
                               icon="#{resource['images:punch-out-O.png']}"
                               hoverIcon="#{resource['images:punch-out-F.png']}"
                               visible="#{row.AttendanceDate == row.CurrDate &amp;&amp; row.CheckOutTime == null &amp;&amp; row.CheckInTime != null &amp;&amp; view.viewId=='/userProfile'}"
                               actionListener="#{pageFlowScope.HrBean.punchoutBtnActnLsnr}" styleClass="but"
                               inlineStyle="background-color:#42c6ff;">
                      <af:setPropertyListener from="#{'Punch-out'}" to="#{sessionScope.attendance}" type="action"/>
                    </af:button>
                  </af:column>
                  <af:column headerText="#{bindings.AttendanceV.hints.Status.label}" id="c10">
                    <af:inputText value="#{row.bindings.Status.inputValue}"
                                  label="#{bindings.AttendanceV.hints.Status.label}"
                                  required="#{bindings.AttendanceV.hints.Status.mandatory}"
                                  columns="#{bindings.AttendanceV.hints.Status.displayWidth}"
                                  maximumLength="#{bindings.AttendanceV.hints.Status.precision}"
                                  shortDesc="#{bindings.AttendanceV.hints.Status.tooltip}" id="it3" readOnly="true">
                      <f:validator binding="#{row.bindings.Status.validator}"/>
                    </af:inputText>
                  </af:column>
                  <af:column headerText="#{bindings.AttendanceV.hints.WorkHours.label}" id="c11">
                    <af:inputText value="#{row.bindings.WorkHours.inputValue}"
                                  label="#{bindings.AttendanceV.hints.WorkHours.label}"
                                  required="#{bindings.AttendanceV.hints.WorkHours.mandatory}"
                                  columns="#{bindings.AttendanceV.hints.WorkHours.displayWidth}"
                                  maximumLength="#{bindings.AttendanceV.hints.WorkHours.precision}"
                                  shortDesc="#{bindings.AttendanceV.hints.WorkHours.tooltip}" id="it4" readOnly="true">
                      <f:validator binding="#{row.bindings.WorkHours.validator}"/>
                      <af:convertNumber groupingUsed="false" pattern="#{bindings.AttendanceV.hints.WorkHours.format}"/>
                    </af:inputText>
                  </af:column>
                  <af:column headerText="#{bindings.AttendanceV.hints.Remarks.label}" id="c9">
                    <af:inputText value="#{row.bindings.Remarks.inputValue}"
                                  label="#{bindings.AttendanceV.hints.Remarks.label}"
                                  required="#{bindings.AttendanceV.hints.Remarks.mandatory}"
                                  columns="#{bindings.AttendanceV.hints.Remarks.displayWidth}"
                                  maximumLength="#{bindings.AttendanceV.hints.Remarks.precision}"
                                  shortDesc="#{bindings.AttendanceV.hints.Remarks.tooltip}" id="it2" readOnly="true">
                      <f:validator binding="#{row.bindings.Remarks.validator}"/>
                    </af:inputText>
                  </af:column>
                </af:table>
              </af:panelGroupLayout>
            </f:facet>
          </af:panelSplitter>
        </af:showDetailItem>
        <af:showDetailItem id="tab2" text="#{viewcontrollerBundle.YourVacations}"
                           badge="#{viewcontrollerBundle.YourVacations}">
          <af:panelHeader text=" " id="ph2">
            <f:facet name="context"/>
            <f:facet name="menuBar"/>
            <f:facet name="toolbar">
              <af:button text="#{viewcontrollerBundle.SubmitVacation}" id="b3" action="toSubmitVacation"
                         useWindow="true" windowEmbedStyle="inlineDocument" windowHeight="400" windowWidth="700"
                         icon="#{resource['images:NewF.png']}" rendered="#{pageFlowScope.pViewForUser}">
                <af:setPropertyListener from="#{bindings.OrgCode.inputValue}" to="#{pageFlowScope.pOrgCode}"
                                        type="action"/>
              </af:button>
            </f:facet>
            <f:facet name="legend"/>
            <f:facet name="info"/>
            <af:panelSplitter id="ps3" orientation="vertical" splitterPosition="335"
                              inlineStyle="margin-right:5px;padding-left:100px;">
              <f:facet name="first">
                <dvt:barChart id="barChart1" var="row" value="#{bindings.EmployeeVacationsStatisticsV.collectionModel}"
                              title="#{viewcontrollerBundle.EMPLOYEE_VACATIONS_CHART}"
                              emptyText="#{viewcontrollerBundle.EMPLOYEE_VACATIONS_CHART}"
                              subtitle="#{bindings.Year.inputValue} #{bindings.Month.inputValue}"
                              inlineStyle="width:500px;font-size:30px;">
                  <dvt:chartLegend id="cl2"/>
                  <dvt:chartY2Axis id="cya1"/>
                  <f:facet name="dataStamp">
                    <dvt:chartDataItem id="di2" value="#{row.TotalDays}" group="#{row.Year} #{row.Month}"
                                       series="#{row.VacationName} #{row.VacationNameAr}" labelPosition="insideBarEdge"
                                       label="#{row.VacationName}"/>
                  </f:facet>
                </dvt:barChart>
              </f:facet>
              <f:facet name="second">
                <af:panelGroupLayout id="pgl6" layout="vertical">
                  <af:panelSplitter id="ps1" orientation="vertical" splitterPosition="50" disabled="true">
                    <f:facet name="first">
                      <af:panelGroupLayout id="pgl7" layout="horizontal">
                        <af:panelGroupLayout id="pgl8" layout="horizontal">
                          <af:outputText value=" "
                                         inlineStyle="background-color:#008000; width:10px; height:10px; display:inline-block; border:1px solid #008000;"
                                         id="ot27"/>
                          <af:outputText value="#{viewcontrollerBundle.Approved}" id="ot28"/>
                          <f:facet name="separator">
                            <af:spacer width="10" height="10" id="s6"/>
                          </f:facet>
                        </af:panelGroupLayout>
                        <f:facet name="separator">
                          <af:spacer width="20" height="10" id="s5"/>
                        </f:facet>
                        <af:panelGroupLayout id="pgl9" layout="horizontal">
                          <af:outputText value=" "
                                         inlineStyle="background-color:#FF0000; width:10px; height:10px; display:inline-block; border:1px solid #FF0000;"
                                         id="ot29"/>
                          <af:outputText value="#{viewcontrollerBundle.Rejected}" id="ot30"/>
                          <f:facet name="separator">
                            <af:spacer width="10" height="10" id="s7"/>
                          </f:facet>
                        </af:panelGroupLayout>
                        <af:panelGroupLayout id="pgl10" layout="horizontal">
                          <af:outputText value=" "
                                         inlineStyle="background-color:#ffa500; width:10px; height:10px; display:inline-block; border:1px solid #ffa500;"
                                         id="ot31"/>
                          <af:outputText value="#{viewcontrollerBundle.Pending}" id="ot32"/>
                          <f:facet name="separator">
                            <af:spacer width="10" height="10" id="s8"/>
                          </f:facet>
                        </af:panelGroupLayout>
                      </af:panelGroupLayout>
                    </f:facet>
                    <f:facet name="second">
                      <af:table value="#{bindings.UserVacationsV.collectionModel}" var="row"
                                rows="#{bindings.UserVacationsV.rangeSize}"
                                emptyText="#{bindings.UserVacationsV.viewable ? 'No data to display.' : 'Access Denied.'}"
                                rowBandingInterval="0"
                                selectedRowKeys="#{bindings.UserVacationsV.collectionModel.selectedRow}"
                                selectionListener="#{bindings.UserVacationsV.collectionModel.makeCurrent}"
                                rowSelection="single" fetchSize="#{bindings.UserVacationsV.rangeSize}"
                                filterModel="#{bindings.UserVacationsVQuery.queryDescriptor}"
                                queryListener="#{bindings.UserVacationsVQuery.processQuery}" filterVisible="true"
                                varStatus="vs" id="t3" autoHeightRows="0" partialTriggers="::b3">
                        <af:column sortProperty="#{bindings.UserVacationsV.hints.Id.name}" filterable="true"
                                   sortable="true" headerText="#{bindings.UserVacationsV.hints.Id.label}" id="c12"
                                   rendered="false">
                          <af:inputText value="#{row.bindings.Id.inputValue}"
                                        label="#{bindings.UserVacationsV.hints.Id.label}"
                                        required="#{bindings.UserVacationsV.hints.Id.mandatory}"
                                        columns="#{bindings.UserVacationsV.hints.Id.displayWidth}"
                                        maximumLength="#{bindings.UserVacationsV.hints.Id.precision}"
                                        shortDesc="#{bindings.UserVacationsV.hints.Id.tooltip}" id="it5">
                            <f:validator binding="#{row.bindings.Id.validator}"/>
                            <af:convertNumber groupingUsed="false"
                                              pattern="#{bindings.UserVacationsV.hints.Id.format}"/>
                          </af:inputText>
                        </af:column>
                        <af:column sortProperty="#{bindings.UserVacationsV.hints.VacationCode.name}" filterable="true"
                                   sortable="true" headerText="#{bindings.UserVacationsV.hints.VacationCode.label}"
                                   id="c13" width="200">
                          <af:selectOneChoice value="#{row.bindings.VacationCode.inputValue}"
                                              label="#{row.bindings.VacationCode.label}"
                                              required="#{bindings.UserVacationsV.hints.VacationCode.mandatory}"
                                              shortDesc="#{bindings.UserVacationsV.hints.VacationCode.tooltip}"
                                              readOnly="true" id="soc1" autoSubmit="true">
                            <f:selectItems value="#{row.bindings.VacationCode.items}" id="si1"/>
                            <f:validator binding="#{row.bindings.VacationCode.validator}"/>
                          </af:selectOneChoice>
                        </af:column>
                        <af:column sortProperty="#{bindings.UserVacationsV.hints.RegisterDt.name}" filterable="true"
                                   sortable="true" headerText="#{bindings.UserVacationsV.hints.RegisterDt.label}"
                                   id="c14" width="120">
                          <f:facet name="filter">
                            <af:inputDate value="#{bindings.UserVacationsVQuery.queryDescriptor.filterConjunctionCriterion.criterionMap.RegisterDt.value}"
                                          id="id5">
                              <af:convertDateTime pattern="#{bindings.UserVacationsV.hints.RegisterDt.format}"/>
                            </af:inputDate>
                          </f:facet>
                          <af:inputDate value="#{row.bindings.RegisterDt.inputValue}"
                                        label="#{bindings.UserVacationsV.hints.RegisterDt.label}"
                                        required="#{bindings.UserVacationsV.hints.RegisterDt.mandatory}"
                                        columns="#{bindings.UserVacationsV.hints.RegisterDt.displayWidth}"
                                        shortDesc="#{bindings.UserVacationsV.hints.RegisterDt.tooltip}" id="id6"
                                        readOnly="true">
                            <f:validator binding="#{row.bindings.RegisterDt.validator}"/>
                            <af:convertDateTime pattern="#{bindings.UserVacationsV.hints.RegisterDt.format}"
                                                type="both"/>
                          </af:inputDate>
                        </af:column>
                        <af:column sortProperty="#{bindings.UserVacationsV.hints.FrmDt.name}" filterable="true"
                                   sortable="true" headerText="#{bindings.UserVacationsV.hints.FrmDt.label}" id="c15"
                                   width="100">
                          <f:facet name="filter">
                            <af:inputDate value="#{bindings.UserVacationsVQuery.queryDescriptor.filterConjunctionCriterion.criterionMap.FrmDt.value}"
                                          id="id7">
                              <af:convertDateTime pattern="#{bindings.UserVacationsV.hints.FrmDt.format}"/>
                            </af:inputDate>
                          </f:facet>
                          <af:inputDate value="#{row.bindings.FrmDt.inputValue}"
                                        label="#{bindings.UserVacationsV.hints.FrmDt.label}"
                                        required="#{bindings.UserVacationsV.hints.FrmDt.mandatory}"
                                        columns="#{bindings.UserVacationsV.hints.FrmDt.displayWidth}"
