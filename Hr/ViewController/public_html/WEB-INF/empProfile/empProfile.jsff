    <af:resource type="javascript">

var watchId = null;

var geoStarted = false;
var geoCollected = false;

var bestAccuracy = 999999;
var bestLat = null;
var bestLon = null;

var GOOD_ACCURACY = 500;

var geo = {};

function initGeoElements() {

    geo.status =
        document.querySelector('span[id$="otStatus"]');

    geo.lat =
        document.querySelector('input[id$="itLat::content"]');

    geo.lon =
        document.querySelector('input[id$="itLon::content"]');

    geo.acc =
        document.getElementById('accHidden');

    geo.map =
        document.querySelector('iframe[id$="mapFrame::f"]');
}

function updateStatus(message) {

    if (geo.status) {
        geo.status.innerHTML = message;
    }
}

function stopGeolocation() {

    if (watchId != null) {
        navigator.geolocation.clearWatch(watchId);
        watchId = null;
    }
}

function updateMap(lat, lon) {

    if (!geo.map) {
        return;
    }

    var delta = 0.01;

    var bbox =
        (parseFloat(lon) - delta) + "," +
        (parseFloat(lat) - delta) + "," +
        (parseFloat(lon) + delta) + "," +
        (parseFloat(lat) + delta);

    var mapUrl =
        "https://www.openstreetmap.org/export/embed.html?bbox=" +
        bbox +
        "&amp;layer=mapnik&amp;marker="
        lat + "," + lon;

    geo.map.src = mapUrl;
}

function storeLocation(lat, lon, acc) {

    if (geo.lat) {
        geo.lat.value = lat;
    }

    if (geo.lon) {
        geo.lon.value = lon;
    }

    if (geo.acc) {
        geo.acc.value = acc;
    }

    geoCollected = true;

    updateMap(lat, lon);

    updateStatus(
        "Location acquired (Accuracy: " +
        acc +
        " meters)"
    );

    stopGeolocation();
}

function startGeolocation() {

    if (geoStarted) {
        return;
    }

    geoStarted = true;

    initGeoElements();

    if (!navigator.geolocation) {

        updateStatus(
            "Geolocation is not supported by this browser."
        );

        return;
    }

    updateStatus("Acquiring current location...");

    watchId = navigator.geolocation.watchPosition(

        function(position) {

            var accuracy =
                Math.round(position.coords.accuracy);

            var lat =
                position.coords.latitude;

            var lon =
                position.coords.longitude;

            if (accuracy &lt; bestAccuracy) {

                bestAccuracy = accuracy;
                bestLat = lat;
                bestLon = lon;
            }

            if (accuracy &lt;= GOOD_ACCURACY) {

                storeLocation(
                    bestLat.toFixed(6),
                    bestLon.toFixed(6),
                    bestAccuracy
                );
            }
        },

        function(error) {

            stopGeolocation();

            updateStatus(
                "Location error: " +
                error.message
            );
        },

        {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 0
        }
    );

    window.setTimeout(function() {

        if (!geoCollected &amp;&amp;bestLat != null) {

            storeLocation(
                bestLat.toFixed(6),
                bestLon.toFixed(6),
                bestAccuracy
            );

            updateStatus(
                "Approximate location acquired " +
                "(Accuracy: " +
                bestAccuracy +
                " meters)"
            );
        }

        stopGeolocation();

    }, 10000);
}

AdfPage.PAGE.addLoadEvent(startGeolocation);

</af:resource>

</ui:composition>
