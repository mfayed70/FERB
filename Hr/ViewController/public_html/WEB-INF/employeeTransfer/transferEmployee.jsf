<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE html>
<f:view xmlns:f="http://java.sun.com/jsf/core" xmlns:af="http://xmlns.oracle.com/adf/faces/rich"
        xmlns:c="http://java.sun.com/jsp/jstl/core">
    <c:set var="viewcontrollerBundle" value="#{adfBundle['com.aalm.hr.view.AalmHrBndl']}"/>
    <af:document id="d1">
        <af:messages id="m1"/>
        <af:form id="f1">
            <af:panelHeader text="#{viewcontrollerBundle.TransferEmployee}" id="ph1">
                <f:facet name="context"/>
                <f:facet name="menuBar">
                    <af:button text="#{viewcontrollerBundle.SAVE}" id="b1"
                               action="toSave" actionListener="#{pageFlowScope.HrBean.saveTransferEmp}"/>
                </f:facet>
                <f:facet name="toolbar">
                    <af:button actionListener="#{bindings.Rollback.execute}" text="#{viewcontrollerBundle.CANCEL}" immediate="true" id="b2" action="toCancel">
                        <af:resetActionListener/>
                    </af:button>
                </f:facet>
                <f:facet name="legend"/>
                <f:facet name="info"/>
                <af:panelFormLayout id="pfl1">
                    <af:inputText value="#{bindings.Seq.inputValue}" label="#{bindings.Seq.hints.label}"
                                  required="#{bindings.Seq.hints.mandatory}"
                                  columns="#{bindings.Seq.hints.displayWidth}"
                                  maximumLength="#{bindings.Seq.hints.precision}"
                                  shortDesc="#{bindings.Seq.hints.tooltip}" id="it1" readOnly="true">
                        <f:validator binding="#{bindings.Seq.validator}"/>
                        <af:convertNumber groupingUsed="false" pattern="#{bindings.Seq.format}"/>
                    </af:inputText>
                    <af:inputText value="#{bindings.EmpId.inputValue}"
                                  required="#{bindings.EmpId.hints.mandatory}"
                                  columns="#{bindings.EmpId.hints.displayWidth}"
                                  maximumLength="#{bindings.EmpId.hints.precision}"
                                  shortDesc="#{bindings.EmpId.hints.tooltip}" id="it2"
                                  label="#{bindings.EmpId.hints.tooltip}" readOnly="true">
                        <f:validator binding="#{bindings.EmpId.validator}"/>
                        <af:convertNumber groupingUsed="false" pattern="#{bindings.EmpId.format}"/>
                    </af:inputText>
                    <af:activeOutputText value="#{pageFlowScope.pEmpName}" id="aot1"/>
                    <af:selectOneChoice value="#{bindings.JobId.inputValue}" label="#{bindings.JobId.label}"
                                        required="#{bindings.JobId.hints.mandatory}"
                                        shortDesc="#{bindings.JobId.hints.tooltip}" id="soc1" autoSubmit="true">
                        <f:selectItems value="#{bindings.JobId.items}" id="si1"/>
                        <f:validator binding="#{bindings.JobId.validator}"/>
                    </af:selectOneChoice>
                    <af:outputText value="#{bindings.OrgType.inputValue}" shortDesc="#{bindings.OrgType.hints.tooltip}"
                                   id="ot1" rendered="false"/>
                    <af:inputDate value="#{bindings.FrmDt.inputValue}" label="#{bindings.FrmDt.hints.label}"
                                  required="#{bindings.FrmDt.hints.mandatory}"
                                  columns="#{bindings.FrmDt.hints.displayWidth}"
                                  shortDesc="#{bindings.FrmDt.hints.tooltip}" id="id1">
                        <f:validator binding="#{bindings.FrmDt.validator}"/>
                        <af:convertDateTime pattern="#{bindings.FrmDt.format}"/>
                    </af:inputDate>
                    <af:outputText value="#{bindings.MaxFrmDt.inputValue}"
                                   shortDesc="#{bindings.MaxFrmDt.hints.tooltip}" id="ot2" rendered="false">
                        <af:convertDateTime pattern="#{bindings.MaxFrmDt.format}"/>
                    </af:outputText>
                    <af:selectBooleanCheckbox value="#{bindings.FullTime.inputValue}" label="#{bindings.FullTime.label}"
                                              shortDesc="#{bindings.FullTime.hints.tooltip}" id="sbc1"
                                              autoSubmit="true"/>
                    <af:selectOneChoice value="#{bindings.ProjId.inputValue}" label="#{bindings.ProjId.label}"
                                        required="#{bindings.ProjId.hints.mandatory}"
                                        shortDesc="#{bindings.ProjId.hints.tooltip}" id="soc2"
                                        visible="#{bindings.OrgType.inputValue=='D'}" partialTriggers="soc1 ot1">
                        <f:selectItems value="#{bindings.ProjId.items}" id="si2"/>
                        <f:validator binding="#{bindings.ProjId.validator}"/>
                    </af:selectOneChoice>
                </af:panelFormLayout>
            </af:panelHeader>
        </af:form>
    </af:document>
</f:view>