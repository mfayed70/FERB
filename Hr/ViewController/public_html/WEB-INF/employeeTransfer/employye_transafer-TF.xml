<?xml version="1.0" encoding="UTF-8" ?>
<adfc-config xmlns="http://xmlns.oracle.com/adf/controller" version="1.2">
  <task-flow-definition id="employye_transafer-TF">
    <default-activity>CreateInsert</default-activity>
    <transaction>
      <requires-transaction/>
    </transaction>
    <data-control-scope>
      <shared/>
    </data-control-scope>
    <input-parameter-definition id="__2">
      <name>fromOrgType</name>
      <value>#{pageFlowScope.fromOrgType}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <input-parameter-definition id="__4">
      <name>fromJobId</name>
      <value>#{pageFlowScope.fromJobId}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <input-parameter-definition id="__5">
      <name>toJobId</name>
      <value>#{pageFlowScope.toJobId}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <input-parameter-definition id="__6">
      <name>toProjId</name>
      <value>#{pageFlowScope.toProjId}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <input-parameter-definition id="__7">
      <name>pEmpName</name>
      <value>#{pageFlowScope.pEmpName}</value>
      <class>java.lang.String</class>
    </input-parameter-definition>
    <input-parameter-definition id="__8">
      <name>pEmpId</name>
      <value>#{pageFlowScope.pEmpId}</value>
      <class>java.lang.Integer</class>
    </input-parameter-definition>
    <managed-bean id="__9">
      <managed-bean-name>HrBean</managed-bean-name>
      <managed-bean-class>com.aalm.hr.view.beans.HrBean</managed-bean-class>
      <managed-bean-scope>pageFlow</managed-bean-scope>
    </managed-bean>
    <view id="transferEmployee">
      <page>/WEB-INF/employeeTransfer/transferEmployee.jsf</page>
    </view>
    <task-flow-return id="Commit">
      <outcome>
        <name>Commit</name>
        <commit/>
      </outcome>
    </task-flow-return>
    <task-flow-return id="Rollback">
      <outcome>
        <name>Rollback</name>
        <rollback/>
      </outcome>
    </task-flow-return>
    <method-call id="CreateInsert">
      <method>#{bindings.CreateInsert.execute}</method>
      <outcome>
        <fixed-outcome>CreateInsert</fixed-outcome>
      </outcome>
    </method-call>
    <control-flow-rule id="__10">
      <from-activity-id>transferEmployee</from-activity-id>
      <control-flow-case id="__11">
        <from-outcome>toSave</from-outcome>
        <to-activity-id>Commit</to-activity-id>
      </control-flow-case>
      <control-flow-case id="__12">
        <from-outcome>toCancel</from-outcome>
        <to-activity-id>Rollback</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
    <control-flow-rule id="__1">
      <from-activity-id>CreateInsert</from-activity-id>
      <control-flow-case id="__3">
        <from-outcome>CreateInsert</from-outcome>
        <to-activity-id>transferEmployee</to-activity-id>
      </control-flow-case>
    </control-flow-rule>
  </task-flow-definition>
</adfc-config>
